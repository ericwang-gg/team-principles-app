{
  "name": "team-principles-app",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:relay": "npm run dev:relay --workspace packages/functions",
    "dev:api": "npm run dev:api --workspace packages/functions",
    "dev:web": "npm run dev --workspace packages/web",
    "dev": "concurrently -n relay,api,web -c blue,green,magenta \"npm:dev:relay\" \"npm:dev:api\" \"npm:dev:web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "sst": "^3.4.0",
    "typescript": "^5.6.3"
  }
}
