# Copy this file to .env.local (git-ignored) and fill in real values.

# Server-side only — never expose this to the frontend bundle.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-sonnet-5
RELAY_PORT=8787
API_PORT=8788

# Read by the web app (Vite requires the VITE_ prefix to expose these to the browser).
# Point these at the deployed SST endpoints once AWS is set up; for local-only
# testing the defaults below (local relay + local API server) already work.
VITE_WS_URL=ws://localhost:8787
VITE_API_URL=http://localhost:8788

# Test/demo mode: pre-fills every answer/comment field and replaces the three
# live Claude calls with fixed canned content, so you can click through the
# whole flow solo without typing real answers or spending real API calls.
# Leave unset/false for normal use.
VITE_DEMO_MODE=false
